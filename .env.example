# RageTV Server Environment Variables (BFF)
# DO NOT add secrets to client-side bundles (no VITE_ prefix for secrets)

# Twitch Helix API Credentials
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# YouTube Data API v3 Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# PandaScore API Token (for tournament fixtures in M4)
PANDASCORE_TOKEN=your_pandascore_token_here
